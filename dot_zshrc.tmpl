# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# Disabled 2026-04-16 in favor of starship.
# if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#   source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
# fi

# If you come from bash you might have to change your $PATH.
export PATH=$HOME/bin:$HOME/.local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME=""

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in $ZSH/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' mode disabled  # disable automatic updates
# zstyle ':omz:update' mode auto      # update automatically without asking
# zstyle ':omz:update' mode reminder  # just remind me to update when it's time

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 13

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# You can also set it to another string to have that shown instead of the default red dots.
# e.g. COMPLETION_WAITING_DOTS="%F{yellow}waiting...%f"
# Caution: this setting can cause issues with multiline prompts in zsh < 5.7.1 (see #5765)
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
  git
  z
  sudo
  extract
  web-search
  copypath
  copyfile
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# --- Starship (replaces p10k as of 2026-04-16) -------------------------------
# Must run AFTER oh-my-zsh so OMZ's prompt is overridden.
[[ -f "$HOME/.config/starship.toml" ]] && eval "$(starship init zsh)"

# ============================================================================
# User configuration (ported from ~/.config/fish/config.fish via chezmoi)
# ============================================================================

# --- Paths: user-local tooling ----------------------------------------------
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"
[[ -d "$HOME/.mavis/bin" ]] && export PATH="$HOME/.mavis/bin:$PATH"

# --- Flutter / Java / Android SDK / TeX --------------------------------------
[[ -d "$HOME/flutter/bin" ]] && export PATH="$HOME/flutter/bin:$PATH"
if [[ -d /opt/homebrew/opt/openjdk@17 ]]; then
  export JAVA_HOME="/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
  export PATH="/opt/homebrew/opt/openjdk@17/bin:$PATH"
fi
if [[ -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
  export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"
fi
[[ -d /Library/TeX/texbin ]] && export PATH="/Library/TeX/texbin:$PATH"

# --- Locale ------------------------------------------------------------------
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# --- Clash Verge local mixed HTTP proxy (CLI tools only) ---------------------
if command -v nc >/dev/null 2>&1 && nc -z 127.0.0.1 7897 >/dev/null 2>&1; then
  export http_proxy=http://127.0.0.1:7897
  export https_proxy=http://127.0.0.1:7897
  export HTTP_PROXY="$http_proxy"
  export HTTPS_PROXY="$https_proxy"
  export ALL_PROXY=http://127.0.0.1:7897
  export no_proxy=localhost,127.0.0.1,::1
  export NO_PROXY="$no_proxy"
fi

# --- Colima docker socket ----------------------------------------------------
[[ -S "$HOME/.colima/default/docker.sock" ]] && export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"

# --- zoxide (smarter cd) -----------------------------------------------------
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# --- atuin (magical shell history) -------------------------------------------
# https://github.com/atuinsh/atuin — requires the brew daemon (auto-started
# the first time zsh runs this) for search-as-you-type. Run `atuin login` to
# enable encrypted cross-machine history sync.
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"

# Restore default zsh up-arrow history (atuin's `init zsh` hijacks ^[[A / ^[OA).
# Ctrl+R (atuin-search) is left as-is so fuzzy search across sessions still works.
bindkey -M emacs '^[[A' up-line-or-history
bindkey -M viins '^[[A' up-line-or-history
bindkey -M vicmd '^[[A' up-line-or-history
bindkey -M emacs '^[OA' up-line-or-history
bindkey -M viins '^[OA' up-line-or-history
bindkey -M vicmd '^[OA' up-line-or-history
bindkey -M vicmd 'k' up-line-or-history

# --- Codely / Tuanjie Cowork paths (also in ~/.zprofile, mirrored for
#     non-login interactive shells like VS Code's terminal) -------------------
for p in "/Applications/Tuanjie Cowork.app/Contents/MacOS" \
         "$HOME/Library/Application Support/Tuanjie Cowork/bin" \
         "/Applications/Tuanjie Cowork.app/Contents/MacOS/app/resource/core/bin/darwin-arm64"; do
  [[ -d "$p" ]] && export PATH="$PATH:$p"
done

# --- Secrets -----------------------------------------------------------------
export NOTION_MCP_TOKEN="${NOTION_MCP_TOKEN:-}"

# --- Editor ------------------------------------------------------------------
export EDITOR=nvim

# --- Aliases -----------------------------------------------------------------
if command -v lsd >/dev/null 2>&1; then
  alias ls='lsd'
  alias l='lsd -l'
  alias la='lsd -a'
  alias lla='lsd -la'
  alias lt='lsd --tree'
fi
alias ll='lsd -alF'
# 2026-10-02: was 'rg --color=auto' (broke grep -E/-o); PATH -> ~/.local/bin/grep (ugrep)
# alias grep='rg --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gd='git diff'

# --- SSH TERM 自动降级:服务器不认识 xterm-ghostty 时自动改用 xterm-256color ---
# 只在 ssh/scp/rsync 命令上触发,不影响日常 TERM
ssh() {
  local new_term
  if [[ "$TERM" == xterm-ghostty ]]; then
    new_term=xterm-256color
  else
    new_term="$TERM"
  fi
  command env TERM="$new_term" ssh "$@"
}
compdef ssh=ssh
alias scp='command env TERM=xterm-256color scp'
alias rsync='command env TERM=xterm-256color rsync'
# --- Tmux shortcuts (ported from fish ~/.config/fish/conf.d/tmux.fish) -------
# See ~/.config/fish/functions/tx-proj.fish for the original tx-proj.

# tx-proj — attach to (or create) a tmux session named after the current dir.
# Usage:  cd ~/Projects/myapp  &&  tx-proj
#   - First run:  creates session "proj-myapp" in $PWD
#   - Later runs: reattaches the same session
#   - Safe whether invoked from inside or outside tmux
tx-proj() {
  local name="proj-$(basename "$PWD")"

  # Create detached when missing so we don't end up with nested foreground sessions.
  if ! tmux has-session -t "$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$PWD"
  fi

  # Inside tmux: switch the current client. Outside: attach a fresh client.
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$name"
  else
    tmux attach-session -t "$name"
  fi
}

# zj-proj — attach to (or create) a Zellij session named after the current dir.
zj-proj() {
  local name="proj-$(basename "$PWD")"

  if [[ -n "$ZELLIJ" ]]; then
    if zellij list-sessions --short | awk -v name="$name" '$0 == name { found=1 } END { exit !found }'; then
      zellij action switch-session -c "$PWD" "$name"
    else
      zellij attach --create-background "$name" && zellij action switch-session -c "$PWD" "$name"
    fi
  else
    zellij attach --create "$name"
  fi
}

# ta — attach to most recent session
ta() { tmux a "$@"; }

# tn <name> — new named session
tn() { tmux new -s "$@"; }

# tl — list all sessions
tl() { tmux ls; }

# tk <name> — kill a session
tk() { tmux kill-session -t "$@"; }

